{
  "name": "aipet",
  "version": "0.0.0",
  "description": "AI 桌宠 — 由你亲手塑造、会主动关心你、能和你一起玩的 AI 桌宠",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json,md}\"",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.2",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "pinia": "^2.2.0",
    "three": "^0.184.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vue-eslint-parser": "^9.0.0",
    "vue-tsc": "^2.0.0"
  }
}
